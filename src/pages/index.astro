---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CatCard from '../components/CatCard.astro';
import NewsList from '../components/NewsList.astro';
import { news, cats } from '../lib/content';
import { links, cafe } from '../data/site';

const openCats = cats.filter((c) => c.status !== '譲渡決定').slice(0, 3);
---
<Base>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="kicker">NPO法人 Human Animal Pairs</p>
        <h1>人と動物の<br />絆をつくる。</h1>
        <p class="lead">
          獣医師を中心としたNPO法人です。動物病院で保護した猫たちを、
          保護猫カフェ「CAT HOME GARDEN」から新しい家族のもとへ。
          子どもたちと一緒に、命を大切にする地域をつくっています。
        </p>
        <div class="btn-row">
          <a class="btn" href="/cats/">里親募集中の猫たち</a>
          <a class="btn outline" href="/about/">私たちについて</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="blob">
          <img src="/images/cafe.jpg" alt="保護猫カフェ CAT HOME GARDEN で過ごす猫" width="640" height="420" />
        </div>
        <img class="mark" src="/images/logo-mark.png" alt="" aria-hidden="true" />
      </div>
    </div>
  </section>

  <!-- 私たちの取り組み -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="en">What we do</span>
        <h2>私たちの取り組み</h2>
        <p>多頭飼育崩壊など、社会で問題となっている動物の課題に向き合いながら、人と動物がともに幸せに暮らせる地域を目指しています。</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <div class="icon-badge"><Icon name="heart" /></div>
          <h3>保護と譲渡</h3>
          <p>動物病院で保護した猫たちに医療ケアを行い、新しい家族へつなぎます。</p>
        </div>
        <div class="card">
          <div class="icon-badge"><Icon name="child" /></div>
          <h3>子どもたちの社会教育</h3>
          <p>中高生から社会人まで、さまざまなボランティアが参加。動物のお世話を通じて、命と向き合う学びの場をつくります。</p>
        </div>
        <div class="card">
          <div class="icon-badge"><Icon name="shield" /></div>
          <h3>ペット信託の支援</h3>
          <p>飼い主さまに「もしも」のことがあっても、大切なペットが安心して暮らし続けられるよう、ペット信託のご相談をサポートしています。</p>
        </div>
      </div>
      <p class="center" style="margin-top:36px"><a class="btn outline" href="/activities/">活動内容を詳しく見る</a></p>
    </div>
  </section>

  <!-- CAT HOME GARDEN -->
  <section class="section tint">
    <div class="container chg">
      <div class="chg-photo">
        <img src="/images/cafe.jpg" alt="CAT HOME GARDEN の店内" loading="lazy" width="640" height="420" />
      </div>
      <div>
        <span class="en-label">Protected cat café</span>
        <h2>保護猫カフェ<br />CAT HOME GARDEN</h2>
        <p>{cafe.catch}。カフェでくつろぎながら猫たちとふれあい、相性の良い子と出会えます。気になる子がいたら、スタッフにお気軽にご相談ください。</p>
        <p class="btn-row"><a class="btn" href="/cat-home-garden/">カフェの案内を見る</a><a class="btn outline" href={cafe.url} target="_blank" rel="noopener">公式サイト ↗</a></p>
      </div>
    </div>
  </section>

  <!-- 里親募集 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="en">Adoption</span>
        <h2>新しい家族を待っています</h2>
        <p>すべての猫は健康チェックを済ませています。譲渡の流れや条件は里親募集ページをご覧ください。</p>
      </div>
      <div class="grid grid-3">
        {openCats.map((c) => <CatCard cat={c} />)}
      </div>
      <p class="center" style="margin-top:36px"><a class="btn outline" href="/cats/">すべての猫を見る</a></p>
    </div>
  </section>

  <!-- 愛玩動物看護師コミュニティ -->
  <section class="section leaf">
    <div class="container vt">
      <div class="icon-badge vt-icon"><Icon name="cross" /></div>
      <div>
        <span class="en-label leaf-text">For veterinary nurses</span>
        <h2>愛玩動物看護師コミュニティ</h2>
        <p>Human Animal Pairs は、愛玩動物看護師のみなさんが学び合い、つながり、長く働き続けられる環境づくりを応援しています。動物病院の働き方改善にも取り組んでいます。</p>
        <p class="btn-row"><a class="btn leaf" href={links.vtCommunity}>コミュニティサイトへ</a></p>
      </div>
    </div>
  </section>

  <!-- お知らせ -->
  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <span class="en">News</span>
        <h2>お知らせ・活動報告</h2>
      </div>
      <NewsList items={news.slice(0, 5)} />
      <p class="center" style="margin-top:32px"><a class="btn outline" href="/news/">お知らせ一覧</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { background: radial-gradient(circle at 85% 20%, #fde4da 0, transparent 45%), radial-gradient(circle at 10% 90%, #eef5ec 0, transparent 40%), var(--bg); padding: 72px 0 88px; overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .kicker { font-family: var(--font-round); color: var(--brand-strong); font-weight: 700; letter-spacing: 0.08em; margin-bottom: 8px; }
  .hero h1 { font-size: clamp(2.2rem, 5.6vw, 3.6rem); line-height: 1.3; margin-bottom: 20px; letter-spacing: 0.06em; }
  .hero .lead { color: var(--ink-soft); margin-bottom: 32px; }
  .hero-visual { position: relative; }
  .blob { border-radius: 58% 42% 48% 52% / 52% 46% 54% 48%; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(160, 80, 50, 0.45); aspect-ratio: 5 / 4; border: 8px solid #fff; }
  .blob img { width: 100%; height: 100%; object-fit: cover; }
  .mark { position: absolute; width: 110px; left: -30px; bottom: -24px; transform: rotate(-10deg); filter: drop-shadow(0 8px 16px rgba(192, 90, 63, 0.25)); }

  .chg { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .chg-photo img { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .chg h2, .vt h2 { font-size: clamp(1.5rem, 3.4vw, 2rem); }
  .en-label { display: block; font-family: var(--font-round); color: var(--brand); letter-spacing: 0.2em; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 4px; }
  .leaf-text { color: #4f7a56; }
  .vt { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: start; max-width: 880px; }
  .vt-icon { width: 96px; height: 96px; background: #fff; color: #4f7a56; }
  .vt-icon :global(svg) { width: 48px; height: 48px; }

  @media (max-width: 860px) {
    .hero { padding: 40px 0 64px; }
    .hero-inner, .chg { grid-template-columns: 1fr; gap: 36px; }
    .hero-visual { order: -1; max-width: 520px; margin: 0 auto; width: 100%; }
    .mark { width: 76px; left: -8px; bottom: -18px; }
    .vt { grid-template-columns: 1fr; gap: 16px; }
    .vt-icon { width: 72px; height: 72px; }
  }
</style>
