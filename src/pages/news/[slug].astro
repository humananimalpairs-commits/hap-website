---
import Base from '../../layouts/Base.astro';
import { news, formatDate, type News } from '../../lib/content';

export function getStaticPaths() {
  return news.map((n) => ({ params: { slug: n.slug }, props: { item: n } }));
}
const { item } = Astro.props as { item: News };
const idx = news.findIndex((n) => n.slug === item.slug);
const newer = news[idx - 1];
const older = news[idx + 1];
---
<Base title={item.title} description={item.excerpt || undefined} image={item.image}>
  <article class="section">
    <div class="container narrow">
      <p class="meta"><time datetime={item.date}>{formatDate(item.date)}</time><span class="tag">{item.category}</span></p>
      <h1>{item.title}</h1>
      {item.image && <img class="eyecatch" src={item.image} alt="" />}
      <div class="prose" set:html={item.html} />
      <nav class="pager" aria-label="前後の記事">
        {older ? <a href={`/news/${older.slug}/`}>← {older.title}</a> : <span />}
        {newer ? <a href={`/news/${newer.slug}/`}>{newer.title} →</a> : <span />}
      </nav>
      <p class="center"><a class="btn outline" href="/news/">お知らせ一覧へ</a></p>
    </div>
  </article>
</Base>
<style>
  .meta { display: flex; gap: 12px; align-items: center; color: var(--ink-soft); font-family: var(--font-round); margin-bottom: 8px; }
  h1 { font-size: clamp(1.5rem, 3.6vw, 2.1rem); margin-bottom: 28px; }
  .eyecatch { border-radius: var(--radius); margin-bottom: 32px; width: 100%; max-height: 480px; object-fit: cover; }
  .pager { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); margin-top: 48px; padding: 24px 0 32px; font-size: 0.92rem; }
  .pager a { max-width: 48%; }
</style>
