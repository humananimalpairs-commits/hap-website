---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { news, formatDate } from '../../lib/content';
---
<Base title="お知らせ・活動報告" description="Human Animal Pairs からのお知らせ、イベント情報、活動報告。">
  <PageHero en="News" title="お知らせ・活動報告" />
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {news.map((n) => (
          <a class="news-card" href={`/news/${n.slug}/`}>
            <div class="thumb">
              {n.image ? <img src={n.image} alt="" loading="lazy" /> : <img class="ph" src="/images/logo-mark.png" alt="" />}
            </div>
            <div class="body">
              <p class="meta"><time datetime={n.date}>{formatDate(n.date)}</time><span class="tag">{n.category}</span></p>
              <h2>{n.title}</h2>
              {n.excerpt && <p class="ex">{n.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .news-card { display: flex; flex-direction: column; background: #fff; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--ink); text-decoration: none; transition: transform 0.15s; }
  .news-card:hover { transform: translateY(-3px); }
  .news-card:hover h2 { color: var(--brand-strong); }
  .thumb { aspect-ratio: 16/10; background: var(--brand-tint); display: grid; place-items: center; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb img.ph { width: 72px; height: auto; opacity: 0.45; }
  .body { padding: 20px 22px 24px; }
  .meta { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; font-size: 0.85rem; color: var(--ink-soft); }
  h2 { font-size: 1.1rem; margin-bottom: 8px; }
  .ex { font-size: 0.9rem; color: var(--ink-soft); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
