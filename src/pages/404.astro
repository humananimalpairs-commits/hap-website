---
import Base from '../layouts/Base.astro';
---
<Base title="ページが見つかりません">
  <section class="section center">
    <div class="container narrow">
      <img src="/images/logo-mark.png" alt="" width="120" style="margin:0 auto 24px;opacity:.7" />
      <h1>ページが見つかりません</h1>
      <p class="muted">お探しのページは移動または削除された可能性があります。</p>
      <p><a class="btn" href="/">トップページへ</a></p>
    </div>
  </section>
</Base>
